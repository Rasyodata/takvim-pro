# Takvim Pro ortam değişkenleri (hepsi isteğe bağlıdır)
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
# sqlite (varsayılan) veya postgres
DB_CLIENT=sqlite
DB_PATH=data/takvim.db
# DB_CLIENT=postgres ise:
# DATABASE_URL=postgres://takvim:takvim@localhost:5432/takvim
APP_TZ=Europe/Istanbul
SESSION_DAYS=30
COOKIE_NAME=takvim_sid
# HTTPS arkasında true olmalı (NODE_ENV=production iken varsayılan true)
COOKIE_SECURE=false
# Ters vekil (nginx, traefik) arkasındaysanız true
TRUST_PROXY=false
# false yapılırsa yalnızca yönetici kullanıcı oluşturabilir (ilk kullanıcı yine kaydolabilir)
ALLOW_REGISTRATION=true
BCRYPT_ROUNDS=11
# Giriş ekranında örnek hesap bilgilerini göster (örnek hesaplar varsa)
SHOW_DEMO_HINT=true
